# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored on purpose — never commit real secrets (Stripe keys, Shippo
# token, VAPID private key). Set the same values in Vercel → Project
# Settings → Environment Variables for production. See README.md for the
# full setup checklist.

# === Supabase ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Shipping ===
SHIPPO_API_TOKEN=shippo_test_or_live_...

# === Givit AI ===
# Gemini generateContent API key used by src/lib/ai/gemini-client.ts.
# VITE_ variables are bundled into the browser; use a browser-restricted key.
VITE_GEMINI_API_KEY=your-gemini-api-key

# === Web Push (real phone/desktop notifications) ===
# Public key is bundled to the client (VITE_ prefix); private key stays
# server-only. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# === AutoGift notification dispatch (api/cron/dispatch-notifications.ts) ===
# Server-only — never prefix these with VITE_. Without them, AutoGift
# reminders stay written to gift_notifications with status='scheduled' but
# are never actually emailed or pushed.
# SUPABASE_URL is the same project URL as VITE_SUPABASE_URL above.
# SUPABASE_SERVICE_ROLE_KEY is the Supabase project's service_role key
# (Project Settings -> API) — it bypasses RLS, so it must stay server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Resend (https://resend.com) — RESEND_FROM_EMAIL must be on a domain
# verified in the Resend dashboard, or sends will fail.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Givit <notifications@yourdomain.com>
# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" — set
# the same value here and in Vercel's Cron Jobs settings so the endpoint
# rejects unauthenticated callers. Leaving it unset disables the check
# (fine for local testing, not for production).
CRON_SECRET=a-long-random-string

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
BASE_PATH=/

# === AutoGift / Concierge Automation ===
NEXT_PUBLIC_GIFT_SURVEY_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_APPROVAL_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_SHIPPING_BUFFER_DAYS=5
NEXT_PUBLIC_ENABLE_EXTERNAL_CHECKOUT_AGENT=false
