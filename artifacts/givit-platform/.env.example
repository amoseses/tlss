# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored on purpose — never commit real secrets (Stripe keys, Shippo
# token, VAPID private key). Set the same values in Vercel → Project
# Settings → Environment Variables for production. See README.md for the
# full setup checklist.

# === Supabase ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Shipping ===
SHIPPO_API_TOKEN=shippo_test_or_live_...

# === Givit AI ===
# Runs client-side via Puter.js (loaded in index.html) — no API key needed.
# See src/lib/ai/puter-client.ts.

# === Web Push (real phone/desktop notifications) ===
# Public key is bundled to the client (VITE_ prefix); private key stays
# server-only. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
BASE_PATH=/

# === AutoGift / Concierge Automation ===
NEXT_PUBLIC_GIFT_SURVEY_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_APPROVAL_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_SHIPPING_BUFFER_DAYS=5
NEXT_PUBLIC_ENABLE_EXTERNAL_CHECKOUT_AGENT=false
