# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored on purpose — never commit real secrets (Stripe keys, Shippo
# token, VAPID private key). Set the same values in Vercel → Project
# Settings → Environment Variables for production. See README.md for the
# full setup checklist.
#
# IMPORTANT: never paste real values into this file. It is committed to a
# public repo — anything typed here is public the moment it's pushed, even
# if you replace it in a later commit (git history keeps it forever).
# Real values only ever go in .env.local (git-ignored) or directly into
# Vercel's Environment Variables page.

# === Supabase ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# === Stripe ===
# Real AutoGift card collection (api/stripe/*.ts + the onboarding wizard's
# Stripe Elements form). STRIPE_SECRET_KEY is server-only, used by
# server/api-lib/stripe.mjs — never prefix it with VITE_. VITE_STRIPE_PUBLISHABLE_KEY
# is safe client-side by design and must use the VITE_ prefix (Vite only
# inlines env vars with that prefix into the browser bundle).
STRIPE_SECRET_KEY=sk_live_or_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...

# === Google Calendar (server/api-lib/google-calendar.mjs, api/auth/google-calendar/callback.ts) ===
# From an OAuth client in Google Cloud Console. Redirect URI is hardcoded
# to https://givit.site/api/auth/google-calendar/callback in
# google-calendar.mjs -- it must match exactly what's registered there,
# so this can't be pointed at a different domain for local testing without
# also adding that URI to the OAuth client's allowed redirects.
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret

# === Shipping ===
SHIPPO_API_TOKEN=shippo_test_or_live_...

# === Givit AI ===
# Groq API key used by src/lib/ai/groq-client.ts (chat completions,
# OpenAI-compatible). Get one at https://console.groq.com/keys — real
# keys start with "gsk_". Groq's free tier is what actually powers Givit
# AI; Gemini required billing to use at any real volume, which is why
# this moved off it.
# VITE_ variables are bundled into the browser.
VITE_GROQ_API_KEY=your-groq-api-key

# === Web Push (real phone/desktop notifications) ===
# Public key is bundled to the client (VITE_ prefix); private key stays
# server-only. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# === AutoGift notification dispatch (api/cron/dispatch-notifications.ts) ===
# Server-only — never prefix these with VITE_. Without them, AutoGift
# reminders stay written to gift_notifications with status='scheduled' but
# are never actually emailed or pushed.
# SUPABASE_URL is the same project URL as VITE_SUPABASE_URL above.
# SUPABASE_SERVICE_ROLE_KEY is the Supabase project's service_role key
# (Project Settings -> API) — it bypasses RLS, so it must stay server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# AWS SDK — credentials are resolved by the default provider chain, which
# on Vercel means these two explicit keys (no IAM role available the way
# there would be on EC2/Lambda). Needs S3 (uploads), SES (email), and SNS
# (SMS) permissions on whatever IAM user these belong to.
# AWS_S3_BUCKET is used for direct browser uploads via api/upload/url.ts.
# SES_FROM_EMAIL must be verified in SES and is also used by
# api/wishlist/send-email.ts. SNS (SMS) reuses AWS_REGION + these same keys.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-upload-bucket
SES_FROM_EMAIL=Givit <notifications@yourdomain.com>
# Shared secret whatever scheduler calls this endpoint (e.g. cron-job.org —
# see README §4) sends as "Authorization: Bearer <value>" — set the same
# value here and in the scheduler's request headers so the endpoint rejects
# unauthenticated callers. Leaving it unset disables the check (fine for
# local testing, not for production).
CRON_SECRET=a-long-random-string

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
BASE_PATH=/

# === AutoGift / Concierge Automation ===
NEXT_PUBLIC_GIFT_SURVEY_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_APPROVAL_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_SHIPPING_BUFFER_DAYS=5
NEXT_PUBLIC_ENABLE_EXTERNAL_CHECKOUT_AGENT=false
