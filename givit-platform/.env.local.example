# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# From: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — NEVER expose publicly, only used in server-side webhooks/workers
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe-safe payment setup ───────────────────────────────────────────────
# Use Stripe Elements + SetupIntents for saved payment methods.
# Never collect or store raw credit-card numbers in Givit tables or local state.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Shipping ────────────────────────────────────────────────────────────────
# From: goshippo.com → API tokens
SHIPPO_API_TOKEN=shippo_test_...

# ── Notifications for 5-week Givit surveys and approval prompts ─────────────
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
NOTIFICATION_EMAIL_FROM=Givit <notifications@example.com>
SMS_PROVIDER_API_KEY=
GIVIT_SURVEY_LEAD_DAYS=35
GIVIT_DELIVERY_BUFFER_DAYS=5

# ── Gift AI and order-provider adapters ─────────────────────────────────────
# The current app includes deterministic gift scoring. Configure a provider key
# when replacing it with a hosted LLM/agent. Use allowlisted provider adapters;
# do not give an unrestricted browser agent raw card data.
GIFT_AI_PROVIDER=local
GIFT_AI_API_KEY=
GIFT_ORDER_ADAPTERS=marketplace,admin_task,affiliate_checkout,digital_delivery
GIFT_EXTERNAL_ORDER_ALLOWLIST=https://api.stripe.com,https://api.goshippo.com
ADMIN_ORDER_EMAIL=orders@example.com
