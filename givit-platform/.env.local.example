SMS_PROVIDER_API_KEY=

# ── Givit Concierge Automation ──────────────────────────────────────────────
# Schedules the Givit survey five weeks before each saved occasion by default.
NEXT_PUBLIC_GIFT_SURVEY_LEAD_DAYS=35
NEXT_PUBLIC_GIFT_APPROVAL_LEAD_DAYS=10
NEXT_PUBLIC_GIFT_SHIPPING_BUFFER_DAYS=5
# Keep false until legal/provider credentials and allow-listed retailer flows are configured.
NEXT_PUBLIC_ENABLE_EXTERNAL_CHECKOUT_AGENT=false
NEXT_PUBLIC_SHIPPO_ENABLED=false
NEXT_PUBLIC_FLORIST_PROVIDER_ENABLED=false
# Server-side worker settings for future fulfillment jobs.
GIFT_ADMIN_ORDER_QUEUE_EMAIL=orders@example.com
GIFT_EXTERNAL_CHECKOUT_ALLOWLIST=
GIFT_CARD_PROVIDER_API_KEY=
GIFT_FLORIST_PROVIDER_API_KEY=
