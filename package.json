{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "dev": "pnpm --filter \"./artifacts/givit-platform\" dev",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/givit-platform\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "stripe": "^22.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
